print("\nComparison Operators:")
print(a > b)
print(a < b)
print(a == b)
print(a != b)

print("\nLogical Operator Demonstration:")
print((a > 0 and b > 0))
print((a > 0 or b > 0))
print(not(a > b))

print("\nAssignment Operator Demonstration:")
c = a
c += b
print(c == a + b)
